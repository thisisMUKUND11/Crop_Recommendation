# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Python scripts (main.py, test.py) read these from the environment.
# Load them into your shell before running, e.g. with python-dotenv, direnv,
# or by exporting manually.

# OpenWeatherMap API key — https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
